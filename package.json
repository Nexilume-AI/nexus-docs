{
  "name": "nexus-agent-router-docs",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "docusaurus start",
    "start:en": "docusaurus start --locale en",
    "build": "node scripts/build-public.mjs",
    "serve": "docusaurus serve",
    "check:docs": "python scripts/check_i18n_parity.py && python scripts/check_public_source.py",
    "check:security": "node --test scripts/dependency-security.test.mjs scripts/image-dimensions.test.mjs",
    "check:api": "python scripts/check_sdk_api_griffe.py && python scripts/generate_sdk_details.py --check",
    "check:sdk-design": "python scripts/check_sdk_design.py",
    "generate:sdk-reference": "python scripts/generate_sdk_reference.py && python scripts/generate_sdk_details.py",
    "check:audit": "python scripts/check_dependency_audit.py"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "copy-webpack-plugin": {
      "serialize-javascript": "7.1.1"
    },
    "css-minimizer-webpack-plugin": {
      "serialize-javascript": "7.1.1"
    },
    "express": {
      "qs": "6.16.0"
    },
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
